{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "codex-bridge": {
        "type": "local",
        "command": [
          "node",
          "C:/path/to/codex-bridge-toolkit/scripts/mcp_server.mjs"
        ],
        "cwd": "C:/path/to/your/project",
        "environment": {
          "CODEX_BRIDGE_EXECUTOR_PROVIDER": "opencode",
          "OPENCODE_SERVER_URL": "http://127.0.0.1:4096"
        },
        "disabled": false
      }
    }
  }
}
